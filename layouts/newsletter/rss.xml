{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>Douglas Ferreira Newsletter</title>
    <link>{{ "newsletter/" | absURL }}</link>
    <description>Monthly digest of posts selected for the Douglas Ferreira newsletter.</description>
    <generator>Hugo</generator>
    <language>{{ .Site.Language.LanguageCode }}</language>
    <atom:link href="{{ "newsletter/index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- $items := where .Site.RegularPages "Draft" false -}}
    {{- $items = where $items "Params.tags" "intersect" (slice "newsletter") -}}
    {{- range sort $items "Date" "desc" }}
      {{- $images := .Resources.ByType "image" -}}
      {{- $cover := $images.GetMatch (.Params.cover | default "*cover*") -}}
      {{- $feature := $images.GetMatch (.Params.feature | default "*feature*") | default $cover -}}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <guid>{{ .Permalink }}</guid>
        <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <author>{{ .Site.Language.Params.Author.name | default .Site.Title }}</author>
        {{- with .Description }}
          <description>{{ . }}</description>
        {{- else }}
          <description>{{ .Summary | plainify }}</description>
        {{- end }}
        {{- with $feature }}
          <media:content url="{{ .Permalink }}" medium="image" />
        {{- else }}
          {{- with .Params.image }}
            <media:content url="{{ . | absURL }}" medium="image" />
          {{- end }}
        {{- end }}
        <content:encoded xmlns:content="http://purl.org/rss/1.0/modules/content/"><![CDATA[
          {{- with $feature }}
            <p><img src="{{ .Permalink }}" alt="{{ $.Title }}" /></p>
          {{- else }}
            {{- with .Params.image }}
              <p><img src="{{ . | absURL }}" alt="{{ $.Title }}" /></p>
            {{- end }}
          {{- end }}
          {{- with .Description }}
            <p>{{ . }}</p>
          {{- else }}
            {{ .Summary }}
          {{- end }}
          <p><a href="{{ .Permalink }}">Read on the site</a></p>
        ]]></content:encoded>
      </item>
    {{- end }}
  </channel>
</rss>
